datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Member {
  id             String          @id @default(cuid())
  name           String
  phone          String
  createdAt      DateTime        @default(now())
  memberBillings MemberBilling[]
}

model BillingCycle {
  id                String          @id @default(cuid())
  month             Int
  year              Int
  name              String
  isClosed          Boolean         @default(false)
  houseRentPaid     Boolean         @default(false)
  houseRentPaidAt   DateTime?
  houseRentPaidNote String?
  createdAt         DateTime        @default(now())
  bills             UtilityBill[]
  memberBillings    MemberBilling[]

  @@unique([year, month])
}

model UtilityBill {
  id                 String       @id @default(cuid())
  billingCycleId     String
  billingCycle       BillingCycle @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)
  name               String       // e.g. "WiFi", "Gas", "Electricity", "Cook/Maid"
  billType           String       @default("VARIABLE") // "FIXED" or "VARIABLE"
  totalAmount        Float
  collectedPerPerson Float        // Custom collected per person (e.g. 165 or 285)
  splitCount         Int?         @default(0) // 0 or null = default all members, > 0 = custom count (e.g. 7 for gas with guest)
  isPaid             Boolean      @default(false)
  paidAt             DateTime?
  paidNote           String?
  createdAt          DateTime     @default(now())
}

model MemberBilling {
  id             String       @id @default(cuid())
  billingCycleId String
  billingCycle   BillingCycle @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roomRent       Float        @default(0) // Individual room rent
  paidAmount     Float        @default(0) // Total amount paid so far
  notes          String?
  updatedAt      DateTime     @updatedAt

  @@unique([billingCycleId, memberId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ImportantNote {
  id            String   @id @default(cuid())
  title         String
  contactNumber String?
  details       String?
  category      String   @default("CONTACT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PantryItem {
  id          String    @id @default(cuid())
  name        String    // Item name, e.g. "মিনিকেট চাল ২৫ কেজি", "সয়াবিন তেল ৫ লিটার", "পেঁয়াজ ২ কেজি"
  quantity    String?   // e.g. "5 kg", "1 bottle", "2 packs"
  category    String    @default("GROCERY") // "GROCERY" (খাবার/বাজার), "ESSENTIAL" (সাবান/পরিষ্কার), "SPICE" (মসলা)
  isCompleted Boolean   @default(false) // false = to buy, true = bought
  urgency     String    @default("NORMAL") // "NORMAL", "URGENT" (জরুরী)
  addedBy     String?   // Roommate name
  notes       String?   // Notes or brand preference
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
